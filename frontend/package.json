{
  "name": "llm-security-workbench",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "browsers:install": "playwright install chromium firefox webkit",
    "test:e2e:report": "playwright show-report --host 127.0.0.1 --port 9323",
    "test:e2e:hosted": "playwright test --config playwright.hosted.config.ts",
    "test:e2e:chromium": "playwright test --project=chromium",
    "browsers:install:chromium": "playwright install chromium",
    "test:visual": "playwright test --project=chromium visual.spec.ts",
    "test:visual:update": "playwright test --project=chromium visual.spec.ts --update-snapshots"
  },
  "dependencies": {
    "lucide-react": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  }
}
