{
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}"
  },
  "tasks": [
    {
      "label": "Labor: Umgebung synchronisieren",
      "type": "shell",
      "command": "uv",
      "args": [
        "sync",
        "--locked",
        "--extra",
        "web",
        "--group",
        "dev"
      ],
      "problemMatcher": [],
      "detail": "Installiert die festgelegten Python-Pakete inklusive Weboberfläche und Tests."
    },
    {
      "label": "Labor: Demo (24 Mock-Laeufe)",
      "type": "shell",
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "--extra",
        "web",
        "python",
        "-m",
        "security_lab",
        "demo"
      ],
      "problemMatcher": [],
      "detail": "Führt 24 kostenlose Mock-Läufe aus; Ergebnisse bleiben lokal unter runs/."
    },
    {
      "label": "Labor: Python-Tests",
      "type": "shell",
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "--extra",
        "web",
        "--group",
        "dev",
        "python",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-v"
      ],
      "group": "test",
      "problemMatcher": [],
      "detail": "Führt alle Python-Tests aus, inklusive PDF- und HTTP-Prüfungen."
    },
    {
      "label": "Labor: Fallkatalog validieren",
      "type": "shell",
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "--extra",
        "web",
        "python",
        "-m",
        "security_lab",
        "validate"
      ],
      "problemMatcher": [],
      "detail": "Prüft die Struktur der Entwicklungsfälle."
    },
    {
      "label": "Labor: Entwicklungskatalog (96 Mock-Laeufe)",
      "type": "shell",
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "--extra",
        "web",
        "python",
        "-m",
        "security_lab",
        "run",
        "--provider",
        "mock",
        "--repeats",
        "1"
      ],
      "problemMatcher": [],
      "detail": "Führt alle Entwicklungsfälle einmal mit vier Varianten und zwei Quellen aus."
    },
    {
      "label": "Labor: Frontend installieren",
      "type": "shell",
      "command": "npm",
      "args": [
        "ci",
        "--no-fund"
      ],
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": [],
      "windows": {
        "command": "npm.cmd"
      },
      "detail": "Installiert npm-Pakete aus der Lockdatei; benötigt Node.js 24 ab 24.15.0."
    },
    {
      "label": "Labor: Frontend bauen",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": [],
      "windows": {
        "command": "npm.cmd"
      },
      "detail": "Prüft TypeScript und baut die Browseroberfläche."
    },
    {
      "label": "Labor: Frontend Tests",
      "type": "shell",
      "command": "npm",
      "args": [
        "test"
      ],
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": [],
      "windows": {
        "command": "npm.cmd"
      },
      "detail": "Führt die React-Tests aus."
    },
    {
      "label": "Labor: Browser installieren",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "browsers:install"
      ],
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": [],
      "windows": {
        "command": "npm.cmd"
      },
      "detail": "Lädt die zur Playwright-Version passenden Chromium-, Firefox- und WebKit-Testbrowser; Systempakete bleiben ein getrennter Schritt."
    },
    {
      "label": "Labor: Browsertests",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "test:e2e"
      ],
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "dependsOn": "Labor: Frontend bauen",
      "problemMatcher": [],
      "windows": {
        "command": "npm.cmd"
      },
      "detail": "Baut das Frontend und führt die Browsermatrix aus. Port 8765 muss frei sein; Tests nutzen einen temporären Workspace."
    },
    {
      "label": "Labor: Browserbericht oeffnen",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "test:e2e:report"
      ],
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": [],
      "windows": {
        "command": "npm.cmd"
      },
      "detail": "Zeigt den letzten Playwright-Bericht unter http://127.0.0.1:9323."
    },
    {
      "label": "Labor: Oberflaeche starten",
      "type": "shell",
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "--extra",
        "web",
        "python",
        "-m",
        "security_lab.web_cli"
      ],
      "dependsOn": "Labor: Frontend bauen",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": [],
      "detail": "Baut das Frontend und startet http://127.0.0.1:8765. Mit Strg+C beenden."
    },
    {
      "label": "Labor: Gesamtinstallation",
      "dependsOn": [
        "Labor: Umgebung synchronisieren",
        "Labor: Frontend installieren",
        "Labor: Frontend bauen"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "detail": "Synchronisiert Python-Pakete, installiert npm-Pakete und baut das Frontend. Git, uv und Node.js müssen bereits verfügbar sein."
    },
    {
      "label": "Labor: Diagnose (nur lesend)",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-B",
        "-m",
        "security_lab.doctor"
      ],
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
      },
      "problemMatcher": [],
      "detail": "Prüft vorhandene Werkzeuge, Build, Port, Speicher, Rechte und Proxy-/CA-Konfiguration. Keine Installation, keine externen Netzwerkanfragen."
    },
    {
      "label": "Labor: Gesamtcheck",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--no-sync",
        "--locked",
        "--extra",
        "web",
        "--group",
        "dev",
        "python",
        "scripts/check_all.py"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [],
      "detail": "Ruff, Python-Tests, React-Tests, TypeScript/Build und Chromium nacheinander; stoppt beim ersten Fehler. Pakete und Browser vorher separat installieren."
    },
    {
      "label": "Labor: Ressourcenprobe (synthetisch)",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--no-sync",
        "--locked",
        "--extra",
        "web",
        "--group",
        "dev",
        "python",
        "scripts/performance_probe.py"
      ],
      "problemMatcher": [],
      "detail": "Begrenzte Mock-/PDF-/API-Messung in einem temporären Workspace. Keine Live-Daten oder Modellaufrufe; JSON im Terminal."
    }
  ]
}
